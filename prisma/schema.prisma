// Shanyraq AI — Prisma schema
//
// NOTE ON DATABASE PROVIDER
// PostgreSQL (hosted, e.g. Neon via the Vercel marketplace) is the primary
// target — it keeps users and sessions persistent across serverless cold
// starts. The schema is portable: no native enums (status fields are strings
// validated with Zod/TS unions).
//
// NOTE ON DATES
// Hotel-business dates (checkIn/checkOut/rate dates) are stored as UTC midnight
// instants and must always be handled through `lib/dates.ts` helpers to avoid
// timezone shifting. Wall-clock timestamps (createdAt etc.) are regular datetimes.

generator client {
  provider      = "prisma-client-js"
  // "native" = local development (Windows/macOS/Linux)
  // "rhel-openssl-3.0.x" = Amazon Linux runtime used by Vercel serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & hotel
// ---------------------------------------------------------------------------

model Organization {
  billingSubscription BillingSubscription?
  billingPayments     BillingPayment[]
  billingNotices      BillingNotice[]
  id                  String               @id @default(cuid())
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  users              User[]
  memberships        Membership[]
  hotels             Hotel[]
  invitations        HotelInvitation[]
  analyticsEvents    AnalyticsEvent[]
  supportRequests    SupportRequest[]
  documentProfile    DocumentProfile?
  documentSequences  DocumentSequence[]
  generatedDocuments GeneratedDocument[]
}

model User {
  id                  String    @id @default(cuid())
  email               String?   @unique // nullable: phone-only accounts are allowed
  phone               String?   @unique
  fullName            String
  firstName           String?
  lastName            String?
  passwordHash        String?
  emailVerifiedAt     DateTime?
  avatarUrl           String?
  onboardingCompleted Boolean   @default(false)
  platformRole        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memberships              Membership[]
  organizations            Organization[] // implicit m-n via Organization.users
  sessions                 Session[]
  oauthAccounts            OAuthAccount[]
  passwordReset            PasswordReset?
  invitationsSent          HotelInvitation[]        @relation("InvitationSender")
  auditLogs                AuditLog[]               @relation("AuditActor")
  notifications            Notification[]           @relation("NotificationRecipient")
  analyticsEvents          AnalyticsEvent[]
  productExperiences       ProductExperience[]
  supportRequests          SupportRequest[]         @relation("SupportRequester")
  assignedSupportRequests  SupportRequest[]         @relation("SupportAssignee")
  supportRequestActivities SupportRequestActivity[] @relation("SupportActivityActor")
  assignedBetaHotels       BetaHotelProfile[]       @relation("BetaAssignedAdmin")
  calendarPreferences      CalendarPreference[]
  guestNotes               GuestNote[]
  generatedDocuments       GeneratedDocument[]      @relation("DocumentCreator")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Pending email registration. Passwords and verification codes are stored only
// as hashes; expired rows can be removed without touching real user accounts.
model EmailRegistration {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String
  firstName    String?
  lastName     String?
  passwordHash String
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

model PasswordReset {
  id         String   @id @default(cuid())
  userId     String   @unique
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// Server-side sessions: the browser holds a random opaque token in an
// httpOnly cookie, the database stores only its SHA-256 hash.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Membership {
  id                  String   @id @default(cuid())
  organizationId      String
  userId              String
  hotelId             String
  role                String // OWNER | MANAGER | STAFF (validated in app layer)
  accessLevel         String   @default("FULL") // OVERVIEW | CALENDAR | FULL
  permissions         String[] @default([]) // granular hotel sections; empty keeps legacy accessLevel behavior
  newReservationEmail Boolean  @default(false)
  dailyDigestEmail    Boolean  @default(true)
  digestHour          Int      @default(10)
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel        Hotel        @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@index([organizationId, userId])
}

model Hotel {
  id           String       @id @default(cuid())
  orgId        String
  slug         String       @unique
  name         String
  propertyType String?
  language     String       @default("ru")
  address      String?
  city         String?
  country      String?
  timezone     String       @default("Asia/Almaty")
  currency     String       @default("KZT")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]

  roomTypes           RoomType[]
  rooms               Room[]
  guests              Guest[]
  reservations        Reservation[]
  ratePlans           RatePlan[]
  availability        Availability[]
  connections         ChannelConnection[]
  channelSyncJobs     ChannelSyncJob[]
  notifications       Notification[]
  invitations         HotelInvitation[]
  organization        Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  analyticsEvents     AnalyticsEvent[]
  productExperiences  ProductExperience[]
  supportRequests     SupportRequest[]
  betaProfile         BetaHotelProfile?
  entitySequence      HotelEntitySequence?
  calendarPreferences CalendarPreference[]
  guestNotes          GuestNote[]
  generatedDocuments  GeneratedDocument[]

  @@unique([id, orgId])
}

// Personal calendar layout preferences. They are scoped to both the employee
// and the hotel, so the same user can keep a different workspace in each property.
model CalendarPreference {
  id                   String   @id @default(cuid())
  userId               String
  hotelId              String
  density              String   @default("STANDARD") // COMFORTABLE | STANDARD | COMPACT
  showGuestName        Boolean  @default(true)
  showGuestCount       Boolean  @default(true)
  showChannel          Boolean  @default(true)
  showAmount           Boolean  @default(false)
  showReservationId    Boolean  @default(false)
  showNotes            Boolean  @default(false)
  currencyDisplay      String   @default("SYMBOL") // SYMBOL | CODE | HIDDEN
  reservationColors    String   @default("BRIGHT") // BRIGHT | CALM
  collapsedRoomTypeIds String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@index([hotelId])
}

// Tenant-local counters back the human-readable numbers shown in the product.
// Internal cuid primary keys stay private and continue to power relations.
model HotelEntitySequence {
  hotelId               String @id
  nextGuestNumber       Int    @default(1)
  nextReservationNumber Int    @default(1)
  nextRatePlanNumber    Int    @default(1)

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

// Legal and banking details entered once and reused in reservation documents.
model DocumentProfile {
  id                    String   @id @default(cuid())
  organizationId        String   @unique
  entityType            String   @default("INDIVIDUAL_ENTREPRENEUR")
  legalName             String
  iinBin                String
  identityDocument      String?
  postalCode            String?
  legalAddress          String
  phone                 String?
  email                 String?
  bankName              String?
  iban                  String?
  bic                   String?
  kbe                   String?
  signerName            String
  signerTitle           String   @default("Руководитель")
  signerAuthority       String?
  accountantName        String?
  vatMode               String   @default("WITHOUT_VAT")
  vatRegistrationNumber String?
  defaultPaymentTerms   String   @default("Оплата наличными или переводом")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Independent counters keep document numbers unique inside each organization.
model DocumentSequence {
  organizationId String
  type           String
  nextNumber     Int    @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, type])
}

// The snapshot is immutable: later profile or reservation changes do not alter issued PDFs.
model GeneratedDocument {
  id             String   @id @default(cuid())
  organizationId String
  hotelId        String
  reservationId  String
  createdById    String
  type           String
  sequenceNumber Int
  documentNumber String
  documentDate   DateTime
  snapshot       Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hotel        Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservation  Reservation  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, type, sequenceNumber])
  @@index([hotelId, createdAt])
  @@index([reservationId, createdAt])
}

// Internal operating record for each hotel participating in the closed beta.
// It is intentionally separate from product activation, which is calculated
// from real usage rather than managed by an administrator.
model BetaHotelProfile {
  hotelId         String    @id
  status          String    @default("NOT_ENROLLED")
  assignedAdminId String?
  startedAt       DateTime?
  lastContactAt   DateTime?
  internalNote    String?
  statusReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hotel         Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  assignedAdmin User? @relation("BetaAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([assignedAdminId])
}

// Privacy-minimal beta product telemetry. Event names are validated in both
// the application and the database; metadata never contains guest details.
model AnalyticsEvent {
  id             String   @id @default(cuid())
  eventType      String
  userId         String?
  organizationId String?
  hotelId        String?
  sessionId      String?
  entityType     String?
  entityId       String?
  metadataJson   String?
  occurredAt     DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  hotel        Hotel?        @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  @@index([eventType, occurredAt])
  @@index([userId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([hotelId, occurredAt])
}

// Per-user, per-hotel progress for the initial setup and lightweight tour.
model ProductExperience {
  id                  String    @id @default(cuid())
  userId              String
  hotelId             String
  setupStep           Int       @default(1)
  setupCompletedAt    DateTime?
  tourCompletedAt     DateTime?
  tourSkippedAt       DateTime?
  feedbackSubmittedAt DateTime?
  feedbackDismissedAt DateTime?
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@index([hotelId])
}

// A small in-product support inbox for the closed beta. Identity and hotel
// scope are always derived from the authenticated session on the server.
model SupportRequest {
  id                   String    @id @default(cuid())
  userId               String?
  organizationId       String?
  hotelId              String?
  category             String
  message              String
  sourcePath           String
  name                 String?
  contact              String?
  transcriptJson       String?
  status               String    @default("OPEN")
  rating               Int?
  feedbackTrigger      String?
  technicalContextJson String?
  assignedToId         String?
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user         User?                    @relation("SupportRequester", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo   User?                    @relation("SupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hotel        Hotel?                   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  activities   SupportRequestActivity[]

  @@index([status, createdAt])
  @@index([hotelId, createdAt])
  @@index([assignedToId, status])
}

model SupportRequestActivity {
  id          String   @id @default(cuid())
  requestId   String
  actorUserId String?
  type        String
  fromStatus  String?
  toStatus    String?
  note        String?
  createdAt   DateTime @default(now())

  request SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?          @relation("SupportActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([actorUserId, createdAt])
}

model HotelInvitation {
  id             String    @id @default(cuid())
  organizationId String
  hotelId        String
  invitedById    String
  email          String
  accessLevel    String
  permissions    String[]  @default([])
  status         String    @default("PENDING")
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hotel        Hotel        @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([hotelId, email])
  @@index([email, status])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model RoomType {
  id          String  @id @default(cuid())
  hotelId     String
  name        String
  description String?
  capacity    Int // max adults
  basePrice   Decimal @db.Decimal(14, 2)
  sortOrder   Int     @default(0)

  hotel               Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms               Room[]
  reservations        Reservation[]
  ratePlans           RatePlan[]
  availability        Availability[]
  channelRoomMappings ChannelRoomMapping[]

  @@unique([hotelId, name])
  @@unique([id, hotelId])
}

model Room {
  id         String @id @default(cuid())
  hotelId    String
  roomTypeId String
  number     String
  floor      Int    @default(1)
  sortOrder  Int    @default(0)
  status     String @default("AVAILABLE") // AVAILABLE | OCCUPIED | CLEANING | MAINTENANCE | OUT_OF_ORDER

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType     RoomType      @relation(fields: [roomTypeId, hotelId], references: [id, hotelId], onDelete: Restrict)
  reservations Reservation[]

  @@unique([hotelId, number])
  @@unique([id, hotelId])
}

// ---------------------------------------------------------------------------
// Guests & reservations
// ---------------------------------------------------------------------------

model Guest {
  id             String  @id @default(cuid())
  hotelId        String
  sequenceNumber Int?
  fullName       String
  email          String?
  phone          String?
  country        String?
  notes          String?

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  internalNotes GuestNote[]

  @@unique([id, hotelId])
  @@unique([hotelId, sequenceNumber])
  @@index([hotelId, fullName])
}

model GuestNote {
  id        String   @id @default(cuid())
  hotelId   String
  guestId   String
  authorId  String
  content   String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  hotel  Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest  Guest @relation(fields: [guestId, hotelId], references: [id, hotelId], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([hotelId, guestId, createdAt])
}

model Reservation {
  id                    String   @id @default(cuid())
  hotelId               String
  guestId               String
  roomId                String
  roomTypeId            String
  ratePlanId            String?
  sequenceNumber        Int?
  sourceChannel         String // booking | ostrovok | krisha | direct
  externalReservationId String? // channel-side id, when imported via a channel
  checkIn               DateTime // UTC midnight (hotel date-only semantics)
  checkOut              DateTime
  checkInTime           String   @default("14:00") // hotel-local HH:mm
  checkOutTime          String   @default("12:00") // hotel-local HH:mm
  adults                Int      @default(1)
  children              Int      @default(0)
  status                String   @default("CONFIRMED") // PENDING | CONFIRMED | CANCELLED | CHECKED_IN | CHECKED_OUT | NO_SHOW
  pricingMode           String   @default("RATE_PLAN") // RATE_PLAN | MANUAL
  currency              String   @default("KZT")
  totalAmount           Decimal  @db.Decimal(14, 2)
  notes                 String?
  paymentMethod         String?  // ONLINE | CASH; nullable for older reservations
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  hotel              Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest              Guest               @relation(fields: [guestId, hotelId], references: [id, hotelId], onDelete: Restrict)
  room               Room                @relation(fields: [roomId, hotelId], references: [id, hotelId], onDelete: Restrict)
  roomType           RoomType            @relation(fields: [roomTypeId, hotelId], references: [id, hotelId], onDelete: Restrict)
  ratePlan           RatePlan?           @relation(fields: [ratePlanId, hotelId], references: [id, hotelId], onDelete: Restrict)
  generatedDocuments GeneratedDocument[]

  @@unique([hotelId, sourceChannel, externalReservationId])
  @@unique([hotelId, sequenceNumber])
  @@index([hotelId, checkIn])
  @@index([hotelId, status])
  @@index([roomId, checkIn, checkOut])
}

// ---------------------------------------------------------------------------
// Rates & availability
// ---------------------------------------------------------------------------

model RatePlan {
  id                String  @id @default(cuid())
  hotelId           String
  roomTypeId        String
  sequenceNumber    Int?
  name              String
  refundable        Boolean @default(true)
  breakfastIncluded Boolean @default(false)
  basePrice         Decimal @db.Decimal(14, 2)
  currency          String  @default("KZT")

  hotel        Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType     RoomType             @relation(fields: [roomTypeId], references: [id])
  rates        Rate[]
  rateMappings ChannelRateMapping[]
  reservations Reservation[]

  @@unique([hotelId, name])
  @@unique([id, hotelId])
  @@unique([hotelId, sequenceNumber])
}

model Rate {
  id         String   @id @default(cuid())
  ratePlanId String
  date       DateTime // UTC midnight
  price      Decimal  @db.Decimal(14, 2)

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, date])
}

model Availability {
  id             String   @id @default(cuid())
  hotelId        String
  roomTypeId     String
  date           DateTime // UTC midnight
  totalRooms     Int
  availableRooms Int // never negative; derived from reservations + manual blocks
  closed         Boolean  @default(false)
  minStay        Int      @default(1)
  maxStay        Int?

  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId, hotelId], references: [id, hotelId], onDelete: Cascade)

  @@unique([hotelId, roomTypeId, date])
  @@index([hotelId, date])
}

// ---------------------------------------------------------------------------
// Channel manager
// ---------------------------------------------------------------------------

model Channel {
  id          String  @id // stable slug: booking | ostrovok | krisha | direct
  name        String
  description String
  isInternal  Boolean @default(false) // Direct sales channel — no external API

  connections ChannelConnection[]
}

model ChannelConnection {
  id                   String    @id @default(cuid())
  hotelId              String
  channelId            String
  status               String    @default("DISCONNECTED") // DISCONNECTED | CONNECTED | ERROR
  externalPropertyId   String?
  // Development placeholder storage. Real deployments must move this behind an
  // encrypted secret store. Never sent to the browser, never logged.
  credentialsJson      String?
  credentialsEncrypted String?
  lastSyncAt           DateTime?
  lastSyncStatus       String? // QUEUED | RUNNING | SUCCESS | PARTIAL | FAILED
  lastError            String?
  importCursor         Int       @default(0) // deterministic mock import position
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  hotel        Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  channel      Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  roomMappings ChannelRoomMapping[]
  rateMappings ChannelRateMapping[]
  syncLogs     SyncLog[]
  syncJobs     ChannelSyncJob[]

  @@unique([hotelId, channelId])
  @@unique([id, hotelId])
}

model ChannelRoomMapping {
  id                 String   @id @default(cuid())
  connectionId       String
  roomTypeId         String
  externalRoomTypeId String
  externalRoomName   String
  mappedAt           DateTime @default(now())

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  roomType   RoomType          @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([connectionId, roomTypeId])
}

model ChannelRateMapping {
  id               String   @id @default(cuid())
  connectionId     String
  ratePlanId       String
  externalRateId   String
  externalRateName String
  mappedAt         DateTime @default(now())

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  ratePlan   RatePlan          @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([connectionId, ratePlanId])
}

model SyncLog {
  id                   String    @id @default(cuid())
  connectionId         String
  channelId            String
  startedAt            DateTime  @default(now())
  finishedAt           DateTime?
  status               String // RUNNING | SUCCESS | PARTIAL | FAILED
  reservationsImported Int       @default(0)
  ratesUpdated         Int       @default(0)
  availabilityUpdated  Int       @default(0)
  message              String? // human-readable summary
  error                String?

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
}

// Durable work queue for OTA synchronization. The nullable deduplication key
// permits completed history while guaranteeing at most one active job for a
// connection. A worker clears the key only after a terminal outcome.
model ChannelSyncJob {
  id               String    @id @default(cuid())
  hotelId          String
  connectionId     String
  deduplicationKey String?   @unique
  status           String    @default("PENDING") // PENDING | RUNNING | SUCCEEDED | FAILED
  attempts         Int       @default(0)
  maxAttempts      Int       @default(6)
  rerunRequested   Boolean   @default(false)
  availableAt      DateTime  @default(now())
  lockedAt         DateTime?
  lockedBy         String?
  finishedAt       DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hotel      Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  connection ChannelConnection @relation(fields: [connectionId, hotelId], references: [id, hotelId], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([hotelId, createdAt])
  @@index([connectionId, createdAt])
}

model Notification {
  id              String    @id @default(cuid())
  hotelId         String
  recipientUserId String?
  type            String
  title           String
  body            String?
  href            String?
  dedupeKey       String?
  readAt          DateTime?
  emailSentAt     DateTime?
  createdAt       DateTime  @default(now())

  hotel         Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  recipientUser User? @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([hotelId, recipientUserId, dedupeKey])
  @@index([recipientUserId, hotelId, readAt, createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  hotelId      String
  actor        String   @default("system") // future: user id from session
  actorUserId  String?
  action       String
  entity       String
  entityId     String?
  metaJson     String?
  oldValueJson String?
  newValueJson String?
  createdAt    DateTime @default(now())

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([hotelId, createdAt])
}

model BillingSubscription {
  organizationId String       @id
  trialStartsAt  DateTime
  trialEndsAt    DateTime
  paidUntil      DateTime?
  planId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model BillingPayment {
  id                String       @id @default(cuid())
  organizationId    String
  planId            String
  months            Int
  amountMinor       Int
  currency          String       @default("KZT")
  testMode          Boolean
  status            String       @default("CREATED")
  providerPaymentId String?      @unique
  checkoutUrl       String?
  expiresAt         DateTime
  paidAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model BillingNotice {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  kind           String
  periodEnd      DateTime
  sentAt         DateTime?
  leaseUntil     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, kind, periodEnd], map: "BillingNotice_period_recipient_key")
}
