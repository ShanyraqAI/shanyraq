// Shanyraq AI — Prisma schema
//
// NOTE ON DATABASE PROVIDER
// The local MVP demo runs on SQLite (zero-setup, file based). The schema is kept
// portable: no native enums (status fields are strings validated with Zod/TS unions),
// so switching to PostgreSQL later is a matter of changing the datasource provider
// and DATABASE_URL, then running `prisma db push`.
//
// NOTE ON DATES
// Hotel-business dates (checkIn/checkOut/rate dates) are stored as UTC midnight
// instants and must always be handled through `lib/dates.ts` helpers to avoid
// timezone shifting. Wall-clock timestamps (createdAt etc.) are regular datetimes.

generator client {
  provider = "prisma-client-js"
  // "native" = local development (Windows/macOS/Linux)
  // "rhel-openssl-3.0.x" = Amazon Linux runtime used by Vercel serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & hotel
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  memberships Membership[]
  hotels      Hotel[]
}

model User {
  id           String    @id @default(cuid())
  email        String?   @unique // nullable: phone-only accounts are allowed
  phone        String?   @unique
  fullName     String
  passwordHash String?
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships   Membership[]
  organizations Organization[] // implicit m-n via Organization.users
  sessions      Session[]
}

// Server-side sessions: the browser holds a random opaque token in an
// httpOnly cookie, the database stores only its SHA-256 hash.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String // OWNER | MANAGER | STAFF (validated in app layer)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Hotel {
  id        String   @id @default(cuid())
  orgId     String?
  slug      String   @unique
  name      String
  address   String?
  city      String?
  country   String?
  timezone  String   @default("Asia/Almaty")
  currency  String   @default("KZT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomTypes     RoomType[]
  rooms         Room[]
  guests        Guest[]
  reservations  Reservation[]
  ratePlans     RatePlan[]
  availability  Availability[]
  connections   ChannelConnection[]
  notifications Notification[]
  organization  Organization?       @relation(fields: [orgId], references: [id])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model RoomType {
  id          String  @id @default(cuid())
  hotelId     String
  name        String
  description String?
  capacity    Int // max adults
  basePrice   Float
  sortOrder   Int     @default(0)

  hotel        Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms        Room[]
  reservations Reservation[]
  ratePlans    RatePlan[]
  availability Availability[]
  channelRoomMappings ChannelRoomMapping[]

  @@unique([hotelId, name])
}

model Room {
  id         String @id @default(cuid())
  hotelId    String
  roomTypeId String
  number     String
  floor      Int    @default(1)
  status     String @default("AVAILABLE") // AVAILABLE | OCCUPIED | CLEANING | MAINTENANCE | OUT_OF_ORDER

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType     RoomType      @relation(fields: [roomTypeId], references: [id])
  reservations Reservation[]

  @@unique([hotelId, number])
}

// ---------------------------------------------------------------------------
// Guests & reservations
// ---------------------------------------------------------------------------

model Guest {
  id      String  @id @default(cuid())
  hotelId String
  fullName String
  email   String?
  phone   String?
  country String?
  notes   String?

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([hotelId, fullName])
}

model Reservation {
  id                   String   @id @default(cuid())
  hotelId              String
  guestId              String
  roomId               String
  roomTypeId           String
  sourceChannel        String // booking | ostrovok | krisha | direct
  externalReservationId String? // channel-side id, when imported via a channel
  checkIn              DateTime // UTC midnight (hotel date-only semantics)
  checkOut             DateTime
  adults               Int      @default(1)
  children             Int      @default(0)
  status               String   @default("CONFIRMED") // PENDING | CONFIRMED | CANCELLED | CHECKED_IN | CHECKED_OUT | NO_SHOW
  currency             String   @default("KZT")
  totalAmount          Float
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest     Guest    @relation(fields: [guestId], references: [id])
  room      Room     @relation(fields: [roomId], references: [id])
  roomType  RoomType @relation(fields: [roomTypeId], references: [id])

  @@index([hotelId, checkIn])
  @@index([hotelId, status])
  @@index([roomId, checkIn, checkOut])
}

// ---------------------------------------------------------------------------
// Rates & availability
// ---------------------------------------------------------------------------

model RatePlan {
  id                 String  @id @default(cuid())
  hotelId            String
  roomTypeId         String
  name               String
  refundable         Boolean @default(true)
  breakfastIncluded  Boolean @default(false)
  basePrice          Float
  currency           String  @default("KZT")

  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType RoomType  @relation(fields: [roomTypeId], references: [id])
  rates    Rate[]
  rateMappings ChannelRateMapping[]

  @@unique([hotelId, name])
}

model Rate {
  id         String   @id @default(cuid())
  ratePlanId String
  date       DateTime // UTC midnight
  price      Float

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, date])
}

model Availability {
  id             String   @id @default(cuid())
  hotelId        String
  roomTypeId     String
  date           DateTime // UTC midnight
  totalRooms     Int
  availableRooms Int // never negative; derived from reservations + manual blocks
  closed         Boolean  @default(false)
  minStay        Int      @default(1)
  maxStay        Int?

  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([hotelId, roomTypeId, date])
  @@index([hotelId, date])
}

// ---------------------------------------------------------------------------
// Channel manager
// ---------------------------------------------------------------------------

model Channel {
  id          String  @id // stable slug: booking | ostrovok | krisha | direct
  name        String
  description String
  isInternal  Boolean @default(false) // Direct sales channel — no external API

  connections ChannelConnection[]
}

model ChannelConnection {
  id                 String    @id @default(cuid())
  hotelId            String
  channelId          String
  status             String    @default("DISCONNECTED") // DISCONNECTED | CONNECTED | ERROR
  externalPropertyId String?
  // Development placeholder storage. Real deployments must move this behind an
  // encrypted secret store. Never sent to the browser, never logged.
  credentialsJson    String?
  lastSyncAt         DateTime?
  lastSyncStatus     String? // SUCCESS | PARTIAL | FAILED
  lastError          String?
  importCursor       Int       @default(0) // deterministic mock import position
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  hotel       Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  channel     Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  roomMappings ChannelRoomMapping[]
  rateMappings ChannelRateMapping[]
  syncLogs    SyncLog[]

  @@unique([hotelId, channelId])
}

model ChannelRoomMapping {
  id                 String   @id @default(cuid())
  connectionId       String
  roomTypeId         String
  externalRoomTypeId String
  externalRoomName   String
  mappedAt           DateTime @default(now())

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  roomType   RoomType          @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([connectionId, roomTypeId])
}

model ChannelRateMapping {
  id               String   @id @default(cuid())
  connectionId     String
  ratePlanId       String
  externalRateId   String
  externalRateName String
  mappedAt         DateTime @default(now())

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  ratePlan   RatePlan          @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([connectionId, ratePlanId])
}

model SyncLog {
  id                    String    @id @default(cuid())
  connectionId          String
  channelId             String
  startedAt             DateTime  @default(now())
  finishedAt            DateTime?
  status                String // RUNNING | SUCCESS | PARTIAL | FAILED
  reservationsImported  Int       @default(0)
  ratesUpdated          Int       @default(0)
  availabilityUpdated   Int       @default(0)
  message               String? // human-readable summary
  error                 String?

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
}

model Notification {
  id        String   @id @default(cuid())
  hotelId   String
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  hotelId   String
  actor     String   @default("system") // future: user id from session
  action    String
  entity    String
  entityId  String?
  metaJson  String?
  createdAt DateTime @default(now())

  @@index([hotelId, createdAt])
}
