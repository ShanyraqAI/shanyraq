// Shanyraq AI — Prisma schema
//
// NOTE ON DATABASE PROVIDER
// PostgreSQL (hosted, e.g. Neon via the Vercel marketplace) is the primary
// target — it keeps users and sessions persistent across serverless cold
// starts. Most legacy status fields remain strings validated with Zod/TS
// unions; new bounded RentalProperty fields use PostgreSQL-backed Prisma enums.
//
// NOTE ON DATES
// Hotel-business dates (checkIn/checkOut/rate dates) are stored as UTC midnight
// instants and must always be handled through `lib/dates.ts` helpers to avoid
// timezone shifting. Wall-clock timestamps (createdAt etc.) are regular datetimes.

generator client {
  provider      = "prisma-client-js"
  // "native" = local development (Windows/macOS/Linux)
  // "rhel-openssl-3.0.x" = Amazon Linux runtime used by Vercel serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RentalPropertyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RentalPropertyInventoryMode {
  SINGLE_UNIT
  GROUPED_UNITS
}

// ---------------------------------------------------------------------------
// Tenancy & hotel
// ---------------------------------------------------------------------------

model Organization {
  billingSubscription BillingSubscription?
  billingPayments     BillingPayment[]
  billingNotices      BillingNotice[]
  subscriptionGrants  SubscriptionGrant[]
  id                  String               @id @default(cuid())
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  users              User[]
  memberships        Membership[]
  hotels             Hotel[]
  rentalProperties   RentalProperty[]
  invitations        HotelInvitation[]
  analyticsEvents    AnalyticsEvent[]
  supportRequests    SupportRequest[]
  documentProfile    DocumentProfile?
  documentSequences  DocumentSequence[]
  generatedDocuments GeneratedDocument[]
}

model User {
  agreementBundles AgreementBundle[]
  guestPaymentRequests GuestPaymentRequest[]
  documentSigningRequests DocumentSigningRequest[]
  guestCommunications GuestCommunication[]
  id                  String    @id @default(cuid())
  email               String?   @unique // nullable: phone-only accounts are allowed
  phone               String?   @unique
  fullName            String
  firstName           String?
  lastName            String?
  passwordHash        String?
  emailVerifiedAt     DateTime?
  avatarUrl           String?
  onboardingCompleted Boolean   @default(false)
  platformRole        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memberships              Membership[]
  organizations            Organization[] // implicit m-n via Organization.users
  sessions                 Session[]
  oauthAccounts            OAuthAccount[]
  passwordReset            PasswordReset?
  invitationsSent          HotelInvitation[]        @relation("InvitationSender")
  auditLogs                AuditLog[]               @relation("AuditActor")
  notifications            Notification[]           @relation("NotificationRecipient")
  pushSubscriptions        PushSubscription[]
  analyticsEvents          AnalyticsEvent[]
  productExperiences       ProductExperience[]
  supportRequests          SupportRequest[]         @relation("SupportRequester")
  assignedSupportRequests  SupportRequest[]         @relation("SupportAssignee")
  supportRequestActivities SupportRequestActivity[] @relation("SupportActivityActor")
  assignedBetaHotels       BetaHotelProfile[]       @relation("BetaAssignedAdmin")
  calendarPreferences      CalendarPreference[]
  guestNotes               GuestNote[]
  generatedDocuments       GeneratedDocument[]      @relation("DocumentCreator")
  subscriptionGrants       SubscriptionGrant[]      @relation("SubscriptionGrantAdmin")
  operationReceipts OperationReceipt[]
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Pending email registration. Passwords and verification codes are stored only
// as hashes; expired rows can be removed without touching real user accounts.
model EmailRegistration {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String
  firstName    String?
  lastName     String?
  passwordHash String
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

model PasswordReset {
  id         String   @id @default(cuid())
  userId     String   @unique
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// Server-side sessions: the browser holds a random opaque token in an
// httpOnly cookie, the database stores only its SHA-256 hash.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Membership {
  id                  String   @id @default(cuid())
  organizationId      String
  userId              String
  hotelId             String
  role                String // OWNER | MANAGER | STAFF (validated in app layer)
  accessLevel         String   @default("FULL") // OVERVIEW | CALENDAR | FULL
  permissions         String[] @default([]) // granular hotel sections; empty keeps legacy accessLevel behavior
  newReservationEmail Boolean  @default(false)
  dailyDigestEmail    Boolean  @default(true)
  digestHour          Int      @default(10)
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel        Hotel        @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@index([organizationId, userId])
}

model Hotel {
  agreementBundles AgreementBundle[]
  guestPaymentRequests GuestPaymentRequest[]
  kaspiPaymentMethods KaspiPaymentMethod[]
  documentSigningRequests DocumentSigningRequest[]
  communicationProfiles CommunicationProfile[]
  communicationTemplates CommunicationTemplate[]
  communicationPhotos CommunicationPhoto[]
  guestCommunications GuestCommunication[]
  id           String       @id @default(cuid())
  orgId        String
  slug         String       @unique
  name         String
  propertyType String?
  language     String       @default("ru")
  address      String?
  city         String?
  country      String?
  timezone     String       @default("Asia/Almaty")
  currency     String       @default("KZT")
  defaultCheckInTime  String @default("14:00")
  defaultCheckOutTime String @default("12:00")
  incomeTaxRatePercent Decimal? @db.Decimal(5, 2)
  houseRules         String @default("")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]

  rentalProperties    RentalProperty[]
  roomTypes           RoomType[]
  rooms               Room[]
  guests              Guest[]
  reservations        Reservation[]
  channelCommissionSettings ChannelCommissionSetting[]
  financialOperations FinancialOperation[]
  expenses            Expense[]
  ratePlans           RatePlan[]
  availability        Availability[]
  connections         ChannelConnection[]
  channelSyncJobs     ChannelSyncJob[]
  channexProperties   ChannexProperty[]
  channexRoomMappings ChannexRoomTypeMapping[]
  channexRateMappings ChannexRatePlanMapping[]
  channexBookings     ChannexBooking[]
  channexRevisions    ChannexBookingRevision[]
  channexSyncJobs     ChannexSyncJob[]
  channexBookingLinks ChannexBookingReservation[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
  invitations         HotelInvitation[]
  organization        Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  analyticsEvents     AnalyticsEvent[]
  productExperiences  ProductExperience[]
  supportRequests     SupportRequest[]
  betaProfile         BetaHotelProfile?
  entitySequence      HotelEntitySequence?
  calendarPreferences CalendarPreference[]
  guestNotes          GuestNote[]
  generatedDocuments  GeneratedDocument[]
  ttlockConnection    TTLockConnection?
  ttlockLocks         TTLockLock[]
  ttlockPasscodes     TTLockPasscode[]
  ttlockEvents        TTLockEvent[]

  @@unique([id, orgId])
  operationReceipts OperationReceipt[]
}

// A customer-facing accommodation inside the legacy Hotel workspace.
// Hotel remains the workspace boundary during the expand-and-contract rollout.
model RentalProperty {
  guestPaymentRequests GuestPaymentRequest[]
  kaspiPaymentMethods KaspiPaymentMethod[]
  id             String                      @id @default(cuid())
  organizationId String
  hotelId        String
  internalName   String
  publicName     String
  propertyType   String?
  status         RentalPropertyStatus        @default(ACTIVE)
  inventoryMode  RentalPropertyInventoryMode
  address        String?
  city           String?
  country        String?
  timezone       String                      @default("Asia/Almaty")
  currency       String                      @default("KZT")
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hotel             Hotel             @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  roomTypes         RoomType[]
  rooms             Room[]
  reservations      Reservation[]
  ratePlans         RatePlan[]
  channexProperties ChannexProperty[]
  channexSyncJobs   ChannexSyncJob[]
  financialOperations FinancialOperation[]

  @@unique([id, hotelId])
  @@unique([id, hotelId, organizationId])
  @@index([organizationId, hotelId])
}

// Personal calendar layout preferences. They are scoped to both the employee
// and the hotel, so the same user can keep a different workspace in each property.
model CalendarPreference {
  id                   String   @id @default(cuid())
  userId               String
  hotelId              String
  density              String   @default("STANDARD") // COMFORTABLE | STANDARD | COMPACT
  rangeDays            Int      @default(14)
  roomColumnWidth      String   @default("STANDARD") // COMPACT | STANDARD | WIDE
  showGuestName        Boolean  @default(true)
  showGuestCount       Boolean  @default(true)
  showChannel          Boolean  @default(true)
  showAmount           Boolean  @default(false)
  showReservationId    Boolean  @default(false)
  showNotes            Boolean  @default(false)
  currencyDisplay      String   @default("SYMBOL") // SYMBOL | CODE | HIDDEN
  reservationColors    String   @default("BRIGHT") // BRIGHT | CALM
  collapsedRoomTypeIds String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@index([hotelId])
}

// Tenant-local counters back the human-readable numbers shown in the product.
// Internal cuid primary keys stay private and continue to power relations.
model HotelEntitySequence {
  hotelId               String @id
  nextGuestNumber       Int    @default(1)
  nextReservationNumber Int    @default(1)
  nextRatePlanNumber    Int    @default(1)

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

// Legal and banking details entered once and reused in reservation documents.
model DocumentProfile {
  id                    String   @id @default(cuid())
  organizationId        String   @unique
  entityType            String   @default("INDIVIDUAL_ENTREPRENEUR")
  legalName             String
  iinBin                String
  identityDocument      String?
  postalCode            String?
  legalAddress          String
  phone                 String?
  email                 String?
  bankName              String?
  iban                  String?
  bic                   String?
  kbe                   String?
  signerName            String
  signerTitle           String   @default("Руководитель")
  signerAuthority       String?
  accountantName        String?
  vatMode               String   @default("WITHOUT_VAT")
  vatRegistrationNumber String?
  defaultPaymentTerms   String   @default("Оплата наличными или переводом")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Independent counters keep document numbers unique inside each organization.
model DocumentSequence {
  organizationId String
  type           String
  nextNumber     Int    @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, type])
}

// The snapshot is immutable: later profile or reservation changes do not alter issued PDFs.
model GeneratedDocument {
  signingRequests DocumentSigningRequest[]
  id             String   @id @default(cuid())
  organizationId String
  hotelId        String
  reservationId  String
  createdById    String
  type           String
  sequenceNumber Int
  documentNumber String
  documentDate   DateTime
  snapshot       Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hotel        Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservation  Reservation  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, organizationId, hotelId, reservationId])
  @@unique([organizationId, type, sequenceNumber])
  @@index([hotelId, createdAt])
  @@index([reservationId, createdAt])
}

// Internal operating record for each hotel participating in the closed beta.
// It is intentionally separate from product activation, which is calculated
// from real usage rather than managed by an administrator.
model BetaHotelProfile {
  hotelId         String    @id
  status          String    @default("NOT_ENROLLED")
  assignedAdminId String?
  startedAt       DateTime?
  lastContactAt   DateTime?
  internalNote    String?
  statusReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hotel         Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  assignedAdmin User? @relation("BetaAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([assignedAdminId])
}

// Privacy-minimal beta product telemetry. Event names are validated in both
// the application and the database; metadata never contains guest details.
model AnalyticsEvent {
  id             String   @id @default(cuid())
  eventType      String
  userId         String?
  organizationId String?
  hotelId        String?
  sessionId      String?
  entityType     String?
  entityId       String?
  metadataJson   String?
  occurredAt     DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  hotel        Hotel?        @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  @@index([eventType, occurredAt])
  @@index([userId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([hotelId, occurredAt])
}

// Per-user, per-hotel progress for the initial setup and lightweight tour.
model ProductExperience {
  id                  String    @id @default(cuid())
  userId              String
  hotelId             String
  setupStep           Int       @default(1)
  setupCompletedAt    DateTime?
  tourCompletedAt     DateTime?
  tourSkippedAt       DateTime?
  feedbackSubmittedAt DateTime?
  feedbackDismissedAt DateTime?
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@index([hotelId])
}

// A small in-product support inbox for the closed beta. Identity and hotel
// scope are always derived from the authenticated session on the server.
model SupportRequest {
  id                   String    @id @default(cuid())
  userId               String?
  organizationId       String?
  hotelId              String?
  category             String
  message              String
  sourcePath           String
  name                 String?
  contact              String?
  transcriptJson       String?
  status               String    @default("OPEN")
  rating               Int?
  feedbackTrigger      String?
  technicalContextJson String?
  assignedToId         String?
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user         User?                    @relation("SupportRequester", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo   User?                    @relation("SupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hotel        Hotel?                   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  activities   SupportRequestActivity[]

  @@index([status, createdAt])
  @@index([hotelId, createdAt])
  @@index([assignedToId, status])
}

model SupportRequestActivity {
  id          String   @id @default(cuid())
  requestId   String
  actorUserId String?
  type        String
  fromStatus  String?
  toStatus    String?
  note        String?
  createdAt   DateTime @default(now())

  request SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?          @relation("SupportActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([actorUserId, createdAt])
}

model HotelInvitation {
  id             String    @id @default(cuid())
  organizationId String
  hotelId        String
  invitedById    String
  email          String
  accessLevel    String
  permissions    String[]  @default([])
  status         String    @default("PENDING")
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hotel        Hotel        @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([hotelId, email])
  @@index([email, status])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model RoomType {
  id               String  @id @default(cuid())
  hotelId          String
  rentalPropertyId String
  name             String
  description      String?
  capacity         Int // max adults
  basePrice        Decimal @db.Decimal(14, 2)
  sortOrder        Int     @default(0)

  hotel               Hotel                    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rentalProperty      RentalProperty           @relation(fields: [rentalPropertyId, hotelId], references: [id, hotelId], onDelete: Restrict)
  rooms               Room[]
  reservations        Reservation[]
  ratePlans           RatePlan[]
  availability        Availability[]
  channelRoomMappings ChannelRoomMapping[]
  channexMappings     ChannexRoomTypeMapping[]

  @@unique([hotelId, name])
  @@unique([id, hotelId])
  @@unique([id, rentalPropertyId, hotelId])
  @@index([rentalPropertyId, hotelId])
}

model Room {
  communicationProfile CommunicationProfile?
  communicationTemplates CommunicationTemplate[]
  communicationPhotos CommunicationPhoto[]
  guestCommunications GuestCommunication[]
  id               String @id @default(cuid())
  hotelId          String
  rentalPropertyId String
  roomTypeId       String
  number           String
  floor            Int    @default(1)
  sortOrder        Int    @default(0)
  status           String @default("AVAILABLE") // AVAILABLE | OCCUPIED | CLEANING | MAINTENANCE | OUT_OF_ORDER

  hotel          Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rentalProperty RentalProperty @relation(fields: [rentalPropertyId, hotelId], references: [id, hotelId], onDelete: Restrict)
  roomType       RoomType       @relation(fields: [roomTypeId, rentalPropertyId, hotelId], references: [id, rentalPropertyId, hotelId], onDelete: Restrict)
  reservations   Reservation[]
  ttlockLock     TTLockLock?

  @@unique([hotelId, number])
  @@unique([id, hotelId])
  @@unique([id, rentalPropertyId, hotelId])
  @@index([rentalPropertyId, hotelId])
}

// ---------------------------------------------------------------------------
// Guests & reservations
// ---------------------------------------------------------------------------

model Guest {
  id             String  @id @default(cuid())
  hotelId        String
  sequenceNumber Int?
  fullName       String
  email          String?
  phone          String?
  country        String?
  notes          String?

  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservations  Reservation[]
  internalNotes GuestNote[]

  @@unique([id, hotelId])
  @@unique([hotelId, sequenceNumber])
  @@index([hotelId, fullName])
}

model GuestNote {
  id        String   @id @default(cuid())
  hotelId   String
  guestId   String
  authorId  String
  content   String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  hotel  Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest  Guest @relation(fields: [guestId, hotelId], references: [id, hotelId], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([hotelId, guestId, createdAt])
}

model Reservation {
  agreementBundles AgreementBundle[]
  guestPaymentRequests GuestPaymentRequest[]
  documentSigningRequests DocumentSigningRequest[]
  guestCommunications GuestCommunication[]
  id                    String   @id @default(cuid())
  hotelId               String
  rentalPropertyId      String
  guestId               String
  roomId                String
  roomTypeId            String
  ratePlanId            String?
  sequenceNumber        Int?
  sourceChannel         String // booking | ostrovok | krisha | direct
  externalReservationId String? // channel-side id, when imported via a channel
  checkIn               DateTime // UTC midnight (hotel date-only semantics)
  checkOut              DateTime
  checkInTime           String   @default("14:00") // hotel-local HH:mm
  checkOutTime          String   @default("12:00") // hotel-local HH:mm
  adults                Int      @default(1)
  children              Int      @default(0)
  status                String   @default("CONFIRMED") // PENDING | CONFIRMED | CANCELLED | CHECKED_IN | CHECKED_OUT | NO_SHOW
  pricingMode           String   @default("RATE_PLAN") // RATE_PLAN | MANUAL
  currency              String   @default("KZT")
  totalAmount           Decimal  @db.Decimal(14, 2)
  depositAmount         Decimal  @default(0) @db.Decimal(14, 2)
  depositCollectedAt    DateTime?
  depositReturnedAt     DateTime?
  notes                 String?
  paymentMethod         String? // ONLINE | CASH; nullable for older reservations
  channelBookingAmount  Decimal? @db.Decimal(14, 2)
  otaCommissionAmount   Decimal? @db.Decimal(14, 2)
  otaCommissionSource   String? // CHANNEX | ESTIMATED
  commissionRateSnapshot Decimal? @db.Decimal(7, 4)
  commissionFixedSnapshot Decimal? @db.Decimal(14, 2)
  paymentCollect        String? // property | ota; null means unknown
  paymentType           String?
  financialServices     Json?
  financialComponentsSource String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  hotel               Hotel                       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rentalProperty      RentalProperty              @relation(fields: [rentalPropertyId, hotelId], references: [id, hotelId], onDelete: Restrict)
  guest               Guest                       @relation(fields: [guestId, hotelId], references: [id, hotelId], onDelete: Restrict)
  room                Room                        @relation(fields: [roomId, rentalPropertyId, hotelId], references: [id, rentalPropertyId, hotelId], onDelete: Restrict)
  roomType            RoomType                    @relation(fields: [roomTypeId, rentalPropertyId, hotelId], references: [id, rentalPropertyId, hotelId], onDelete: Restrict)
  ratePlan            RatePlan?                   @relation(fields: [ratePlanId, rentalPropertyId, hotelId], references: [id, rentalPropertyId, hotelId], onDelete: Restrict)
  generatedDocuments  GeneratedDocument[]
  channexBookings     ChannexBooking[]
  channexBookingLinks ChannexBookingReservation[]
  ttlockPasscodes     TTLockPasscode[]
  financialOperations FinancialOperation[]

  @@unique([id, roomId, hotelId])
  @@unique([id, hotelId])
  @@unique([id, rentalPropertyId, hotelId])
  @@unique([hotelId, sourceChannel, externalReservationId])
  @@unique([hotelId, sequenceNumber])
  @@index([hotelId, checkIn])
  @@index([hotelId, status])
  @@index([roomId, checkIn, checkOut])
  @@index([rentalPropertyId, hotelId])
  @@index([hotelId, roomTypeId, checkIn, checkOut])
  @@index([hotelId, guestId, checkIn])
}

// Manual OTA fee settings are applied only to future imported revisions and snapshotted per booking.
model ChannelCommissionSetting {
  id          String   @id @default(cuid())
  hotelId     String
  sourceChannel String
  ratePercent Decimal  @default(0) @db.Decimal(7, 4)
  fixedFee    Decimal  @default(0) @db.Decimal(14, 2)
  currency    String   @default("KZT")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  @@unique([hotelId, sourceChannel])
  @@index([hotelId])
}

model FinancialOperation {
  id                String   @id @default(cuid())
  organizationId    String
  hotelId           String
  rentalPropertyId  String
  reservationId     String
  amount            Decimal  @db.Decimal(14, 2)
  currency          String
  occurredAt        DateTime
  status            String   @default("COMPLETED") // COMPLETED | PENDING | FAILED
  method            String // CASH | CARD | BANK_TRANSFER | OTA | VCC | OTHER
  type              String // PAYMENT | REFUND | EXPENSE
  source            String   @default("MANUAL") // MANUAL | IMPORT | CHANNEX
  externalKey       String?
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  hotel             Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservation       Reservation @relation(fields: [reservationId, rentalPropertyId, hotelId], references: [id, rentalPropertyId, hotelId], onDelete: Cascade)
  rentalProperty    RentalProperty @relation(fields: [rentalPropertyId, hotelId, organizationId], references: [id, hotelId, organizationId], onDelete: Cascade)
  @@unique([hotelId, externalKey])
  @@index([organizationId, hotelId, occurredAt])
  @@index([reservationId, hotelId, type, status])
}

model TTLockConnection {
  id                   String   @id @default(cuid())
  hotelId              String   @unique
  credentials          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  hotel                Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  @@index([hotelId])
}

model TTLockLock {
  id          String   @id @default(cuid())
  hotelId     String
  roomId      String   @unique
  lockId      String
  lockName    String
  lockAlias   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  passcodes   TTLockPasscode[]
  events      TTLockEvent[]
  batteryPercent Int?
  keyboardPwdVersion Int?
  hasGateway  Boolean?
  isOnline    Boolean?
  lockState   String?
  lastSyncedAt DateTime?
  @@unique([hotelId, lockId])
  @@unique([id, hotelId])
  @@index([hotelId])
}

model TTLockPasscode {
  id               String   @id @default(cuid())
  hotelId          String
  lockId           String
  reservationId    String?
  keyboardPwdId    String
  code             String
  name             String
  startsAt         DateTime
  endsAt           DateTime
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  lock             TTLockLock @relation(fields: [lockId], references: [id], onDelete: Cascade)
  reservation      Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  @@unique([lockId, keyboardPwdId])
  @@index([hotelId, startsAt, endsAt])
  @@index([reservationId])
}

model TTLockEvent {
  id          String   @id @default(cuid())
  hotelId     String
  lockRefId   String?
  eventKey    String
  lockId      String
  recordType  Int?
  success     Boolean?
  actor       String?
  eventAt     DateTime?
  summary     String?
  payload     Json
  receivedAt  DateTime @default(now())
  hotel       Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  lock        TTLockLock? @relation(fields: [lockRefId, hotelId], references: [id, hotelId], onDelete: Cascade)
  @@unique([hotelId, eventKey])
  @@index([hotelId, eventAt])
  @@index([lockRefId, eventAt])
}

// ---------------------------------------------------------------------------
// Rates & availability
// ---------------------------------------------------------------------------

model RatePlan {
  id                String  @id @default(cuid())
  hotelId           String
  rentalPropertyId  String
  roomTypeId        String
  sequenceNumber    Int?
  name              String
  refundable        Boolean @default(true)
  breakfastIncluded Boolean @default(false)
  basePrice         Decimal @db.Decimal(14, 2)
  currency          String  @default("KZT")

  hotel           Hotel                    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rentalProperty  RentalProperty           @relation(fields: [rentalPropertyId, hotelId], references: [id, hotelId], onDelete: Restrict)
  roomType        RoomType                 @relation(fields: [roomTypeId, rentalPropertyId, hotelId], references: [id, rentalPropertyId, hotelId], onDelete: Restrict)
  rates           Rate[]
  rateMappings    ChannelRateMapping[]
  channexMappings ChannexRatePlanMapping[]
  reservations    Reservation[]

  @@unique([hotelId, name])
  @@unique([id, hotelId])
  @@unique([id, rentalPropertyId, hotelId])
  @@unique([hotelId, sequenceNumber])
  @@index([rentalPropertyId, hotelId])
}

model Rate {
  id                String   @id @default(cuid())
  ratePlanId        String
  date              DateTime // UTC midnight
  price             Decimal  @db.Decimal(14, 2)
  minStay           Int      @default(1)
  minStayType       String   @default("ARRIVAL") // ARRIVAL | THROUGH
  maxStay           Int?
  stopSell          Boolean  @default(false)
  closedToArrival   Boolean  @default(false)
  closedToDeparture Boolean  @default(false)

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, date])
}

model Availability {
  id             String   @id @default(cuid())
  hotelId        String
  roomTypeId     String
  date           DateTime // UTC midnight
  totalRooms     Int
  availableRooms Int // never negative; derived from reservations + manual blocks
  closed         Boolean  @default(false)
  minStay        Int      @default(1)
  maxStay        Int?

  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId, hotelId], references: [id, hotelId], onDelete: Cascade)

  @@unique([hotelId, roomTypeId, date])
  @@index([hotelId, date])
}

// ---------------------------------------------------------------------------
// Channel manager
// ---------------------------------------------------------------------------

model Channel {
  id          String  @id // stable slug: booking | ostrovok | krisha | direct
  name        String
  description String
  isInternal  Boolean @default(false) // Direct sales channel — no external API

  connections ChannelConnection[]
}

model ChannelConnection {
  id                   String    @id @default(cuid())
  hotelId              String
  channelId            String
  status               String    @default("DISCONNECTED") // DISCONNECTED | CONNECTED | ERROR
  externalPropertyId   String?
  // Development placeholder storage. Real deployments must move this behind an
  // encrypted secret store. Never sent to the browser, never logged.
  credentialsJson      String?
  credentialsEncrypted String?
  lastSyncAt           DateTime?
  lastSyncStatus       String? // QUEUED | RUNNING | SUCCESS | PARTIAL | FAILED
  lastError            String?
  importCursor         Int       @default(0) // deterministic mock import position
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  hotel        Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  channel      Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  roomMappings ChannelRoomMapping[]
  rateMappings ChannelRateMapping[]
  syncLogs     SyncLog[]
  syncJobs     ChannelSyncJob[]

  @@unique([hotelId, channelId])
  @@unique([id, hotelId])
}

model ChannelRoomMapping {
  id                 String   @id @default(cuid())
  connectionId       String
  roomTypeId         String
  externalRoomTypeId String
  externalRoomName   String
  mappedAt           DateTime @default(now())

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  roomType   RoomType          @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([connectionId, roomTypeId])
}

model ChannelRateMapping {
  id               String   @id @default(cuid())
  connectionId     String
  ratePlanId       String
  externalRateId   String
  externalRateName String
  mappedAt         DateTime @default(now())

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  ratePlan   RatePlan          @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([connectionId, ratePlanId])
}

model SyncLog {
  id                   String    @id @default(cuid())
  connectionId         String
  channelId            String
  startedAt            DateTime  @default(now())
  finishedAt           DateTime?
  status               String // RUNNING | SUCCESS | PARTIAL | FAILED
  reservationsImported Int       @default(0)
  ratesUpdated         Int       @default(0)
  availabilityUpdated  Int       @default(0)
  message              String? // human-readable summary
  error                String?

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
}

// Durable work queue for OTA synchronization. The nullable deduplication key
// permits completed history while guaranteeing at most one active job for a
// connection. A worker clears the key only after a terminal outcome.
model ChannelSyncJob {
  id               String    @id @default(cuid())
  hotelId          String
  connectionId     String
  deduplicationKey String?   @unique
  status           String    @default("PENDING") // PENDING | RUNNING | SUCCEEDED | FAILED
  attempts         Int       @default(0)
  maxAttempts      Int       @default(6)
  rerunRequested   Boolean   @default(false)
  availableAt      DateTime  @default(now())
  lockedAt         DateTime?
  lockedBy         String?
  finishedAt       DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hotel      Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  connection ChannelConnection @relation(fields: [connectionId, hotelId], references: [id, hotelId], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([hotelId, createdAt])
  @@index([connectionId, createdAt])
}

// Channex is a transport layer for multiple OTAs. These records intentionally
// live beside the legacy per-channel architecture until that architecture can
// be migrated incrementally without changing existing channel behaviour.
model ChannexProperty {
  id                      String    @id @default(cuid())
  organizationId          String
  hotelId                 String
  rentalPropertyId        String
  environment             String    @default("STAGING") // STAGING | PRODUCTION
  propertyId              String?
  provisioningStatus      String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | READY | FAILED
  provisioningStep        String?
  webhookId               String?
  lastProcessedRevisionId String?
  lastProvisionedAt       DateTime?
  lastFullSyncAt          DateTime?
  lastSyncAt              DateTime?
  lastSyncStatus          String? // QUEUED | RUNNING | SUCCESS | FAILED
  lastBookingPollAt       DateTime?
  lastErrorCode           String?
  lastErrorMessage        String?   @db.VarChar(1000)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  hotel            Hotel                    @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  rentalProperty   RentalProperty           @relation(fields: [rentalPropertyId, hotelId, organizationId], references: [id, hotelId, organizationId], onDelete: Cascade)
  roomTypeMappings ChannexRoomTypeMapping[]
  ratePlanMappings ChannexRatePlanMapping[]
  bookings         ChannexBooking[]
  revisions        ChannexBookingRevision[]
  syncJobs         ChannexSyncJob[]

  @@unique([rentalPropertyId, environment])
  @@unique([environment, propertyId])
  @@unique([environment, webhookId])
  @@unique([id, rentalPropertyId, hotelId, organizationId])
  @@index([organizationId, hotelId])
}

model ChannexRoomTypeMapping {
  id                 String    @id @default(cuid())
  propertyRefId      String
  organizationId     String
  hotelId            String
  rentalPropertyId   String
  roomTypeId         String
  channexRoomTypeId  String?
  provisioningStatus String    @default("PENDING") // PENDING | PROVISIONED | FAILED
  lastErrorCode      String?
  lastErrorMessage   String?   @db.VarChar(1000)
  lastProvisionedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  property ChannexProperty @relation(fields: [propertyRefId, rentalPropertyId, hotelId, organizationId], references: [id, rentalPropertyId, hotelId, organizationId], onDelete: Cascade)
  hotel    Hotel           @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  roomType RoomType        @relation(fields: [roomTypeId, rentalPropertyId, hotelId], references: [id, rentalPropertyId, hotelId], onDelete: Restrict)

  @@unique([propertyRefId, roomTypeId])
  @@unique([propertyRefId, channexRoomTypeId])
  @@index([organizationId, hotelId])
}

model ChannexRatePlanMapping {
  id                 String    @id @default(cuid())
  propertyRefId      String
  organizationId     String
  hotelId            String
  rentalPropertyId   String
  ratePlanId         String
  channexRatePlanId  String?
  provisioningStatus String    @default("PENDING") // PENDING | PROVISIONED | FAILED
  lastErrorCode      String?
  lastErrorMessage   String?   @db.VarChar(1000)
  lastProvisionedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  property ChannexProperty @relation(fields: [propertyRefId, rentalPropertyId, hotelId, organizationId], references: [id, rentalPropertyId, hotelId, organizationId], onDelete: Cascade)
  hotel    Hotel           @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  ratePlan RatePlan        @relation(fields: [ratePlanId, rentalPropertyId, hotelId], references: [id, rentalPropertyId, hotelId], onDelete: Restrict)

  @@unique([propertyRefId, ratePlanId])
  @@unique([propertyRefId, channexRatePlanId])
  @@index([organizationId, hotelId])
}

// The Channex booking is the transport identity. otaCode/otaReservationCode
// preserve the actual sales source (Booking.com, Airbnb, ETG, etc.).
model ChannexBooking {
  id                 String    @id @default(cuid())
  propertyRefId      String
  organizationId     String
  hotelId            String
  rentalPropertyId   String
  reservationId      String?
  channexBookingId   String
  uniqueId           String
  otaCode            String
  otaName            String?
  otaReservationCode String?
  firstSeenAt        DateTime  @default(now())
  lastProviderRevisionAt DateTime?
  lastRevisionAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  property     ChannexProperty             @relation(fields: [propertyRefId, rentalPropertyId, hotelId, organizationId], references: [id, rentalPropertyId, hotelId, organizationId], onDelete: Cascade)
  hotel        Hotel                       @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  reservation  Reservation?                @relation(fields: [reservationId, rentalPropertyId, hotelId], references: [id, rentalPropertyId, hotelId], onDelete: Restrict)
  revisions    ChannexBookingRevision[]
  reservations ChannexBookingReservation[]

  @@unique([propertyRefId, channexBookingId])
  @@unique([propertyRefId, uniqueId])
  @@unique([id, rentalPropertyId, hotelId, organizationId])
  @@index([organizationId, hotelId])
  @@index([reservationId, hotelId])
  @@index([otaCode, otaReservationCode])
}

model ChannexBookingRevision {
  id                  String    @id @default(cuid())
  propertyRefId       String
  organizationId      String
  hotelId             String
  rentalPropertyId    String
  bookingRecordId     String?
  revisionId          String
  channexBookingId    String
  sourceSystemId      String?
  idempotencyKey      String
  eventType           String // NEW | MODIFIED | CANCELLED
  processingStatus    String    @default("RECEIVED") // RECEIVED | PROCESSING | PROCESSED | FAILED
  payload             Json
  attempts            Int       @default(0)
  safeErrorCode       String?
  safeErrorMessage    String?   @db.VarChar(1000)
  receivedAt          DateTime  @default(now())
  processingStartedAt DateTime?
  processedAt         DateTime?
  acknowledgedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  property ChannexProperty @relation(fields: [propertyRefId, rentalPropertyId, hotelId, organizationId], references: [id, rentalPropertyId, hotelId, organizationId], onDelete: Cascade)
  hotel    Hotel           @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  booking  ChannexBooking? @relation(fields: [bookingRecordId, rentalPropertyId, hotelId, organizationId], references: [id, rentalPropertyId, hotelId, organizationId], onDelete: Restrict)

  @@unique([propertyRefId, revisionId])
  @@unique([propertyRefId, idempotencyKey])
  @@index([organizationId, hotelId, processingStatus, receivedAt])
  @@index([propertyRefId, channexBookingId])
  @@index([bookingRecordId, hotelId, organizationId])
}

// One durable property-scoped ARI job coalesces changes before sending at most
// one availability and one restrictions request to Channex per worker run.
model ChannexSyncJob {
  id                    String    @id @default(cuid())
  propertyRefId         String
  organizationId        String
  hotelId               String
  rentalPropertyId      String
  deduplicationKey      String?   @unique
  status                String    @default("PENDING") // PENDING | RUNNING | SUCCEEDED | FAILED
  availabilityRequested Boolean   @default(false)
  restrictionsRequested Boolean   @default(false)
  fullSyncRequested     Boolean   @default(false)
  roomTypeIds           Json
  ratePlanIds           Json
  dateFrom              DateTime
  dateTo                DateTime // inclusive business date
  attempts              Int       @default(0)
  maxAttempts           Int       @default(6)
  rerunRequested        Boolean   @default(false)
  availableAt           DateTime  @default(now())
  lockedAt              DateTime?
  lockedBy              String?
  finishedAt            DateTime?
  lastTaskIds           Json?
  lastErrorCode         String?
  lastErrorMessage      String?   @db.VarChar(1000)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  property       ChannexProperty @relation(fields: [propertyRefId, rentalPropertyId, hotelId, organizationId], references: [id, rentalPropertyId, hotelId, organizationId], onDelete: Cascade)
  hotel          Hotel           @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  rentalProperty RentalProperty  @relation(fields: [rentalPropertyId, hotelId, organizationId], references: [id, hotelId, organizationId], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([propertyRefId, createdAt])
  @@index([organizationId, hotelId])
}

// Channex group bookings contain several rooms while a local Reservation owns
// exactly one physical unit. This table preserves every room independently.
model ChannexBookingReservation {
  id               String   @id @default(cuid())
  bookingRecordId  String
  reservationId    String
  organizationId   String
  hotelId          String
  rentalPropertyId String
  roomKey          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  booking     ChannexBooking @relation(fields: [bookingRecordId, rentalPropertyId, hotelId, organizationId], references: [id, rentalPropertyId, hotelId, organizationId], onDelete: Cascade)
  reservation Reservation    @relation(fields: [reservationId, rentalPropertyId, hotelId], references: [id, rentalPropertyId, hotelId], onDelete: Restrict)
  hotel       Hotel          @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)

  @@unique([bookingRecordId, roomKey])
  @@unique([bookingRecordId, reservationId])
  @@index([reservationId, hotelId])
  @@index([organizationId, hotelId])
}

model Notification {
  id              String    @id @default(cuid())
  hotelId         String
  recipientUserId String?
  type            String
  title           String
  body            String?
  href            String?
  dedupeKey       String?
  readAt          DateTime?
  emailSentAt     DateTime?
  createdAt       DateTime  @default(now())

  hotel         Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  recipientUser User? @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([hotelId, recipientUserId, dedupeKey])
  @@index([recipientUserId, hotelId, readAt, createdAt])
}

model PushSubscription {
  id            String   @id @default(cuid())
  hotelId       String
  userId        String
  endpointHash  String
  encryptedData String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hotelId, userId, endpointHash])
  @@index([hotelId, userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  hotelId      String
  actor        String   @default("system") // future: user id from session
  actorUserId  String?
  action       String
  entity       String
  entityId     String?
  metaJson     String?
  oldValueJson String?
  newValueJson String?
  createdAt    DateTime @default(now())

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([hotelId, createdAt])
}

model BillingSubscription {
  organizationId String       @id
  trialStartsAt  DateTime
  trialEndsAt    DateTime
  paidUntil      DateTime?
  planId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model BillingPayment {
  id                String       @id @default(cuid())
  organizationId    String
  planId            String
  months            Int
  amountMinor       Int
  currency          String       @default("KZT")
  testMode          Boolean
  status            String       @default("CREATED")
  providerPaymentId String?      @unique
  checkoutUrl       String?
  expiresAt         DateTime
  paidAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model BillingNotice {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  kind           String
  periodEnd      DateTime
  sentAt         DateTime?
  leaseUntil     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, kind, periodEnd], map: "BillingNotice_period_recipient_key")
}

/// Subscription issued manually by a platform admin. Current access = grant with the latest endsAt.
model SubscriptionGrant {
  id             String       @id @default(cuid())
  organizationId String
  planId         String // start | pro | business
  startsAt       DateTime
  endsAt         DateTime
  months         Int
  note           String?
  grantedById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantedBy      User?        @relation("SubscriptionGrantAdmin", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([organizationId, endsAt])
}

/// Property expense (utilities, cleaning, rent...). Split equally between roomIds; empty roomIds means every unit.
model Expense {
  id          String   @id @default(cuid())
  hotelId     String
  occurredAt  DateTime
  amount      Decimal  @db.Decimal(14, 2)
  category    String
  comment     String?
  roomIds     String[] @default([])
  createdById String?
  createdAt   DateTime @default(now())
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, occurredAt])
}

// Guest communication: uses the existing workspace, units, guests and reservations.
model CommunicationProfile {
  id String @id @default(cuid())
  organizationId String
  hotelId String
  roomId String @unique
  publicName String @default("")
  address String @default("")
  mapLink String @default("")
  wifiName String @default("")
  wifiPassword String @default("")
  keyInstructions String @default("")
  rulesLink String @default("")
  checkinGuideLink String @default("")
  supportPhone String @default("")
  version Int @default(1)
  updatedAt DateTime @updatedAt
  hotel Hotel @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  room Room @relation(fields: [roomId, hotelId], references: [id, hotelId], onDelete: Cascade)
  @@index([organizationId, hotelId])
  @@unique([roomId, hotelId])
}
model CommunicationTemplate {
  id String @id @default(cuid())
  organizationId String
  hotelId String
  roomId String?
  name String @db.VarChar(160)
  body String @db.VarChar(4096)
  language String @default("ru")
  status String @default("DRAFT")
  isDefault Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hotel Hotel @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  room Room? @relation(fields: [roomId, hotelId], references: [id, hotelId], onDelete: Cascade)
  versions CommunicationTemplateVersion[]
  @@unique([id, hotelId])
  @@index([organizationId, hotelId, status])
}
model CommunicationTemplateVersion {
  id String @id @default(cuid())
  templateId String
  hotelId String
  version Int
  snapshot Json
  createdAt DateTime @default(now())
  template CommunicationTemplate @relation(fields: [templateId, hotelId], references: [id, hotelId], onDelete: Cascade)
  @@unique([templateId, version])
}
model CommunicationPhoto {
  id String @id @default(cuid())
  organizationId String
  hotelId String
  roomId String
  name String @db.VarChar(160)
  contentType String @default("image/jpeg")
  bytes Bytes
  position Int @default(0)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  hotel Hotel @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  room Room @relation(fields: [roomId, hotelId], references: [id, hotelId], onDelete: Cascade)
  @@index([organizationId, hotelId, roomId, archivedAt])
}
model GuestCommunication {
  id String @id @default(cuid())
  organizationId String
  hotelId String
  roomId String
  reservationId String
  createdById String
  requestKey String
  templateId String?
  templateVersion Int?
  recipientPhone String?
  body String @db.VarChar(4096)
  attachments Json
  state String @default("DRAFT")
  createdAt DateTime @default(now())
  handoffAt DateTime?
  hotel Hotel @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  room Room @relation(fields: [roomId, hotelId], references: [id, hotelId], onDelete: Restrict)
  reservation Reservation @relation(fields: [reservationId, roomId, hotelId], references: [id, roomId, hotelId], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@unique([hotelId, requestKey])
  @@index([organizationId, hotelId, createdAt, id])
}

// A capability link to an immutable issued PDF, not a new document generator.
model DocumentSigningRequest {
  id String @id @default(cuid())
  organizationId String
  hotelId String
  reservationId String
  documentId String
  createdById String
  tokenHash String @unique @db.VarChar(64)
  title String @db.VarChar(240)
  pdfBytes Bytes
  pdfHash String @db.VarChar(64)
  reservationVersion DateTime
  expiresAt DateTime
  revokedAt DateTime?
  signedAt DateTime?
  signerName String? @db.VarChar(160)
  consentVersion String?
  evidence Json?
  createdAt DateTime @default(now())
  hotel Hotel @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId, hotelId], references: [id, hotelId], onDelete: Restrict)
  document GeneratedDocument @relation(fields: [documentId, organizationId, hotelId, reservationId], references: [id, organizationId, hotelId, reservationId], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@index([organizationId, hotelId, reservationId, createdAt])
  @@index([documentId, signedAt])
}

model OperationReceipt {
  userId      String
  hotelId     String
  key         String   @db.VarChar(36)
  action      String   @db.VarChar(80)
  requestHash String   @db.VarChar(64)
  resultJson  String
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([userId, hotelId, key])
}


// One ordinary payment link per actual accommodation; never silently inherited from another object.
model KaspiPaymentMethod {
  id String @id @default(cuid())
  organizationId String
  hotelId String
  rentalPropertyId String @unique
  name String @db.VarChar(100)
  recipient String @db.VarChar(160)
  url String @db.VarChar(500)
  enabled Boolean @default(false)
  version Int @default(1)
  updatedAt DateTime @updatedAt
  hotel Hotel @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  rentalProperty RentalProperty @relation(fields: [rentalPropertyId, hotelId, organizationId], references: [id, hotelId, organizationId], onDelete: Cascade)
  @@unique([id, rentalPropertyId, hotelId])
  @@index([organizationId, hotelId])
}

// A saved message request, NOT a completed payment or bank invoice.
model GuestPaymentRequest {
  id String @id @default(cuid())
  organizationId String
  hotelId String
  rentalPropertyId String
  reservationId String
  userId String
  digest String @db.VarChar(64)
  revision String @db.VarChar(64)
  amount Decimal @db.Decimal(14, 2)
  currency String @default("KZT")
  recipient String @db.VarChar(160)
  url String @db.VarChar(500)
  text String
  createdAt DateTime @default(now())
  hotel Hotel @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Cascade)
  rentalProperty RentalProperty @relation(fields: [rentalPropertyId, hotelId, organizationId], references: [id, hotelId, organizationId], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId, rentalPropertyId, hotelId], references: [id, rentalPropertyId, hotelId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([hotelId, userId, digest])
  @@index([reservationId, hotelId, createdAt])
}

// Owner-first immutable acknowledgement, explicitly not an EDS/legal conclusion.
model AgreementBundle {
  id String @id @default(cuid())
  organizationId String
  hotelId String
  reservationId String
  createdById String
  requestKey String @db.VarChar(36)
  requestHash String @db.VarChar(64)
  tokenHash String @unique @db.VarChar(64)
  revision String @db.VarChar(64)
  bundleHash String @db.VarChar(64)
  ownerName String @db.VarChar(160)
  ownerAcceptedAt DateTime @default(now())
  requireOtp Boolean
  expiresAt DateTime
  revokedAt DateTime?
  guestAcceptedAt DateTime?
  guestName String? @db.VarChar(160)
  guestEvidence Json?
  createdAt DateTime @default(now())
  hotel Hotel @relation(fields: [hotelId, organizationId], references: [id, orgId], onDelete: Restrict)
  reservation Reservation @relation(fields: [reservationId, hotelId], references: [id, hotelId], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items AgreementItem[]
  events AgreementEvent[]
  challenges AgreementOtp[]
  @@unique([hotelId, requestKey])
  @@index([organizationId, hotelId, reservationId, createdAt])
}
model AgreementItem {
  id String @id @default(cuid())
  bundleId String
  position Int
  title String @db.VarChar(240)
  kind String @db.VarChar(24)
  required Boolean
  text String?
  pdfBytes Bytes?
  contentHash String @db.VarChar(64)
  sourceDocumentId String?
  bundle AgreementBundle @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  @@unique([bundleId, position])
}
model AgreementEvent {
  id String @id @default(cuid())
  bundleId String
  action String @db.VarChar(40)
  actorId String?
  evidence Json
  createdAt DateTime @default(now())
  bundle AgreementBundle @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  @@index([bundleId, createdAt])
}
model AgreementOtp {
  id String @id @default(cuid())
  bundleId String
  requestKey String @db.VarChar(36)
  phoneHash String @db.VarChar(64)
  codeHash String @db.VarChar(64)
  state String @db.VarChar(16)
  providerMessageId String? @db.VarChar(100)
  expiresAt DateTime
  attempts Int @default(0)
  consumedAt DateTime?
  createdAt DateTime @default(now())
  bundle AgreementBundle @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  @@unique([bundleId, requestKey])
  @@index([phoneHash, createdAt])
}
