{
  "name": "shanyraq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/check-communications-schema.mjs && next build",
    "deploy:prod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-production.ps1",
    "start": "next start",
    "start:e2e": "node --env-file=.env scripts/start-e2e-server.mjs",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:e2e": "node --env-file=.env scripts/migrate-e2e.mjs",
    "db:migrate:channel-secrets": "node --env-file=.env scripts/migrate-channel-credentials.mjs --apply",
    "db:check:channel-secrets": "node --env-file=.env scripts/migrate-channel-credentials.mjs",
    "db:cleanup:demo-channels": "tsx scripts/cleanup-demo-channel-data.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:reset": "tsx scripts/reset-database.ts",
    "admin:grant": "node --env-file=.env scripts/set-platform-admin.mjs grant",
    "admin:revoke": "node --env-file=.env scripts/set-platform-admin.mjs revoke",
    "test:provision:phase2": "node --env-file=.env scripts/provision-phase2-e2e.mjs",
    "test:phase2:e2e": "node --env-file=.env scripts/verify-phase2-e2e.mjs",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:room-tenancy": "tsx scripts/audit-room-tenancy.ts",
    "test:rental-property": "tsx --test src/lib/rental-properties.test.ts",
    "test:rental-property-migration": "node --env-file=.env scripts/verify-rental-property-migration.mjs",
    "test:migrations:clean": "node --env-file=.env scripts/verify-clean-migrations.mjs",
    "test:channex-property-migration": "node --env-file=.env scripts/verify-channex-property-migration.mjs",
    "test:communications": "tsx --test src/lib/communications/template.test.ts src/lib/communications/draft.test.ts",
    "test:communications:db": "tsx scripts/test-guest-communications.ts",
    "test:document-signing": "tsx --test src/lib/documents/signing/security.test.ts",
    "db:migrate:release": "node scripts/vercel-migrate.mjs --apply-reviewed-release",
    "test:reliability": "tsx --test src/lib/reservations/operation.test.ts src/lib/channels/channex/revision-order.test.ts src/lib/offline/outbox.test.ts scripts/release-safety.test.mjs scripts/service-worker.test.mjs src/lib/offline/dispatch.test.ts src/lib/guests/pagination.test.ts",
    "test:reliability:db": "node --require ./scripts/test-server-preload.cjs --import tsx scripts/test-reliability.ts",
    "test:instant-overview": "tsx --test src/lib/offline/read-resource.test.ts src/lib/dashboard/overview-validation.test.ts",
    "test:security-audit": "node --test scripts/security-audit-regressions.test.cjs",
    "test:security-hardening": "node --test scripts/security-hardening.test.cjs",
    "test:security-hardening:db": "tsx scripts/test-security-inbox.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@expo-google-fonts/roboto": "^0.4.2",
    "@expo-google-fonts/tinos": "^0.4.2",
    "@prisma/client": "6.12.0",
    "@vercel/blob": "^2.8.0",
    "ai": "^6.0.282",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "^0.544.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.17.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/web-push": "^3.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "6.12.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "hono": "4.13.7",
    "qs": "6.16.0",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.15"
    }
  }
}
