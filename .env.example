# Copy this file to .env and adjust values

# ── PostgreSQL (primary — persistent across cold starts) ───────────────────
# Neon via the Vercel marketplace: Vercel Dashboard → Storage → Create Database.
# Copy the connection string from the database page (.env.local tab).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Google OAuth (login via Google) ────────────────────────────────────────
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# and add the redirect URIs:
#   http://localhost:3000/api/auth/google/callback
#   https://<your-vercel-app>.vercel.app/api/auth/google/callback
# Leave empty to hide the Google button on /login and /register.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Canonical public origin used for OAuth and CSRF origin validation.
APP_URL="http://localhost:3000"

# Email verification and hotel invitations (Resend).
RESEND_API_KEY=
EMAIL_FROM="Shanyraq AI <no-reply@example.com>"
# Inbox for AI-chat handoffs. Leave empty to keep requests only in the admin panel.
SUPPORT_EMAIL=
VERIFICATION_CODE_SECRET=

# Vercel AI Gateway. On Vercel, OIDC can authenticate automatically;
# set AI_GATEWAY_API_KEY for local development or explicit key-based access.
AI_GATEWAY_API_KEY=
AI_SUPPORT_MODEL="spacexai/grok-4.1-fast-non-reasoning"

# 32 random bytes encoded as base64 or 64 hexadecimal characters.
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=
# Local development only. Production ignores this flag even if set.
ALLOW_MOCK_CHANNEL_PROVIDERS=false

# Channex API credentials are server-only. Use separate keys and entity UUIDs
# for staging and production; never expose these through NEXT_PUBLIC_* values.
# Public build-time switch. Keep false until the server-only values below are set.
NEXT_PUBLIC_CHANNELS_ENABLED=false
CHANNEX_STAGING_API_KEY=
CHANNEX_PRODUCTION_API_KEY=
CHANNEX_STAGING_BASE_URL="https://staging.channex.io/api/v1"
CHANNEX_PRODUCTION_BASE_URL="https://app.channex.io/api/v1"
CHANNEX_REQUEST_TIMEOUT_MS=10000
CHANNEX_MAX_RETRIES=2
# Public route registered as a Channex `booking` webhook. Set both values before
# provisioning a staging property. On Vercel Hobby, the daily cron is a fallback;
# the webhook remains the primary real-time booking notification path.
CHANNEX_WEBHOOK_URL=
CHANNEX_WEBHOOK_SECRET=

# Provisioned automatically by the Vercel Blob integration.
BLOB_READ_WRITE_TOKEN=

# Destructive reset requires all three values and is always blocked in production.
ALLOW_DESTRUCTIVE_DB_RESET=
DISPOSABLE_DATABASE_NAME=

# Isolated database and port used by `npm run start:e2e` after migrations are applied there.
E2E_DATABASE_NAME="shanyraq_e2e_test"
E2E_PORT=3101

# Optional operator convenience only; admin access is granted by the explicit admin:grant command.
SUPERADMIN_EMAIL=

# Freedom Pay: keep billing disabled until merchant sandbox and live acceptance checks pass.
BILLING_ENABLED=false
# Fixed UTC rollout timestamp. Older organizations retain their existing access.
BILLING_START_AT=
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_MODE=test
# Protects daily billing reminders and recovery of queued channel syncs.
CRON_SECRET=
