# Copy this file to .env and adjust values

# ── PostgreSQL (primary — persistent across cold starts) ───────────────────
# Neon via the Vercel marketplace: Vercel Dashboard → Storage → Create Database.
# Copy the connection string from the database page (.env.local tab).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Google OAuth (login via Google) ────────────────────────────────────────
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# and add the redirect URIs:
#   http://localhost:3000/api/auth/google/callback
#   https://<your-vercel-app>.vercel.app/api/auth/google/callback
# Leave empty to hide the Google button on /login and /register.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
