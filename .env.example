# Copy this file to .env and adjust values

# ── Local development (default) ─────────────────────────────────────────────
# SQLite file database, created automatically on first run.
DATABASE_URL="file:./dev.db"

# ── Vercel demo deployment ──────────────────────────────────────────────────
# Serverless filesystems are ephemeral; only /tmp is writable. Set this in the
# Vercel dashboard. The app bootstraps schema + demo data automatically.
# DATABASE_URL="file:/tmp/shanyraq-demo.db"

# ── PostgreSQL (production target, later) ───────────────────────────────────
# DATABASE_URL="postgresql://user:password@localhost:5432/shanyraq?schema=public"

# ── Google OAuth (optional; button is hidden until configured) ─────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ── Google OAuth (login via Google) ────────────────────────────────────────
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# and add the redirect URI: {origin}/api/auth/google/callback
# Leave empty to hide the Google button on /login and /register.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
